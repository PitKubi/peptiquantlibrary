# /etc/systemd/system/peptiquantlibrary.service
# Deliberately its own unit: sysquant deploys restart the sysquant gunicorn and
# must never take the public library down (and vice versa).
[Unit]
Description=PeptiQuant Library (gunicorn)
After=network.target

[Service]
User=peter
Group=www-data
WorkingDirectory=/home/peter/peptiquantlibrary
EnvironmentFile=/etc/peptiquantlibrary/env
ExecStart=/home/peter/peptiquantlibrary/.venv/bin/gunicorn \
    --workers 2 --bind 127.0.0.1:8100 --timeout 60 \
    peptiquantlibrary.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
